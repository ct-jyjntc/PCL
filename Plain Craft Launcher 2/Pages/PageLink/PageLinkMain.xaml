<local:MyPageRight xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCL"
    x:Class="PageLinkMain" PanScroll="PanBack">
    <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <local:MyHint x:Name="HintError" Margin="0,0,0,15" Theme="Yellow" Visibility="Collapsed" />
            <local:MyCard Title="联机" Margin="0,0,0,15">
                <StackPanel Margin="21,40,21,15">
                    <TextBlock x:Name="LabPlayer" Text="先登录游戏账号" Foreground="{DynamicResource ColorBrush3}" FontSize="16" Margin="0,0,0,8" />
                    <TextBlock x:Name="LabStatus" Text="尚未连接" Margin="0,0,0,12" Opacity="0.65" />
                    <TextBlock x:Name="LabNetworkId" FontSize="30" FontFamily="Consolas" Margin="0,0,0,8" Visibility="Collapsed" AutomationProperties.Name="网络 ID" />
                    <TextBlock x:Name="LabNetworkIp" Margin="0,0,0,12" Visibility="Collapsed" TextWrapping="Wrap" />
                    <WrapPanel x:Name="PanNetworkActions">
                        <local:MyButton x:Name="BtnCreate" Text="创建网络" Width="115" Height="35" ColorType="Highlight" IsEnabled="False" Margin="0,0,12,8" />
                        <local:MyTextBox x:Name="TextCode" MaxLength="6" Width="130" Height="35" HintText="6 位网络 ID" IsEnabled="False" Margin="0,0,8,8" AutomationProperties.Name="加入网络 ID" />
                        <local:MyButton x:Name="BtnJoin" Text="加入" Width="90" Height="35" IsEnabled="False" Margin="0,0,0,8" />
                    </WrapPanel>
                    <WrapPanel x:Name="PanConnectedActions" Visibility="Collapsed">
                        <local:MyButton x:Name="BtnCopyCode" Text="复制邀请" Width="110" Height="35" Margin="0,0,10,8" />
                        <local:MyButton x:Name="BtnCopyIp" Text="复制 IP" Width="95" Height="35" Margin="0,0,10,8" />
                        <local:MyButton x:Name="BtnLeave" Text="离开网络" Width="110" Height="35" Margin="0,0,0,8" />
                    </WrapPanel>
                    <local:MyButton x:Name="BtnCancel" Text="取消连接" Width="110" Height="35" HorizontalAlignment="Left" Visibility="Collapsed" />
                    <local:MyButton x:Name="BtnRetry" Text="重试" Width="90" Height="32" HorizontalAlignment="Left" Visibility="Collapsed" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard x:Name="CardRooms" Title="游戏世界" Margin="0,0,0,15" Visibility="Collapsed">
                <StackPanel Margin="21,40,21,15">
                    <TextBlock x:Name="LabDiscovery" Text="尚未发现世界" Margin="0,0,0,10" Opacity="0.65" TextWrapping="Wrap" />
                    <StackPanel x:Name="PanRooms" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard x:Name="CardPeers" Title="网络设备" Margin="0,0,0,15" Visibility="Collapsed">
                <StackPanel x:Name="PanPeers" Margin="21,40,21,15" />
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
